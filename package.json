{
  "name": "anyform-desktop",
  "version": "1.0.2",
  "description": "Anyform - convertisseur de formats (images, données, audio, vidéo) - application de bureau",
  "main": "main.js",
  "author": "BloopStudio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bloopstudio.anyform",
    "productName": "Anyform",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "!public/vendor/ffmpeg/**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "synopsis": "Convertisseur de formats (images, données, audio, vidéo)"
    }
  }
}
