{
  "name": "anyform-desktop",
  "version": "1.0.29",
  "description": "Anyform - convertisseur de formats (images, données, audio, vidéo) - application de bureau",
  "main": "main.js",
  "author": "BloopStudio",
  "license": "MIT",
  "desktopName": "Anyform.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.bloopstudio.anyform",
    "productName": "Anyform",
    "publish": {
      "provider": "github",
      "owner": "TheDEMON78",
      "repo": "Anyform"
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "public/**/*",
      "!public/vendor/ffmpeg/**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "synopsis": "Convertisseur de formats (images, données, audio, vidéo)",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "installerHeader": "build/installer-header.bmp",
      "installerSidebar": "build/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "shortcutName": "Anyform"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
